[Desktop Entry]
Name=Preview
GenericName=macOS Preview
Comment=macOS Document and Image Viewer for Linux
Exec=preview-app %F
Icon=preview-macos
Terminal=false
Type=Application
Categories=Graphics;Office;Viewer;
MimeType=application/pdf;image/png;image/jpeg;image/webp;image/tiff;image/bmp;
StartupNotify=true
StartupWMClass=Preview
